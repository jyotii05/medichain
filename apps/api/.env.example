# ---------------------------------------------------------------------------
# MediChain API — environment configuration (copy to .env and adjust)
# Never commit real credentials. All values below are local-development placeholders.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL. `npm run db:start` launches a local embedded server matching these URLs.
DATABASE_URL=postgresql://medichain:medichain@localhost:54329/medichain
TEST_DATABASE_URL=postgresql://medichain:medichain@localhost:54329/medichain_test

# Auth — generate a long random secret, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Salt used to hash client IPs in verification / audit logs (privacy-conscious analytics)
CLIENT_HASH_SALT=replace-with-another-random-value

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Public URL of the web app — encoded into QR codes as <PUBLIC_APP_URL>/verify/<publicId>
PUBLIC_APP_URL=http://localhost:5173
# Set to true only when the API is served over HTTPS (production)
COOKIE_SECURE=false

# Development-only demo data endpoints (POST /api/dev/sample-data). Always disabled when NODE_ENV=production.
ALLOW_DEMO_SEED=true

# ---------------------------------------------------------------------------
# Blockchain
#   simulation — tamper-evident hash-chained ledger stored in PostgreSQL (clearly labelled as simulated)
#   onchain    — writes to the MediChainRegistry smart contract via ethers.js
# ---------------------------------------------------------------------------
BLOCKCHAIN_MODE=simulation
CHAIN_RPC_URL=http://127.0.0.1:8545
# Address printed by `npm run deploy:local` in packages/contracts
CONTRACT_ADDRESS=
# Private key of the relayer account (must hold RECORDER_ROLE + REGULATOR_ROLE on the contract).
# For a local Hardhat node use one of the well-known development keys printed by `npx hardhat node`.
# NEVER put a key that controls real funds here.
RELAYER_PRIVATE_KEY=
# Number of public verifications of one batch within 24h above which it is flagged as possible code cloning
DUPLICATE_SCAN_THRESHOLD=50
