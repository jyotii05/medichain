{
  "name": "@medichain/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "MediChain smart contracts: on-chain traceability registry for medicine batches (references and hashes only).",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "export-abi": "hardhat compile && node scripts/export-abi.js",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.7.0",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.1"
  }
}
